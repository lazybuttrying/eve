# cp .env.example .env 후 필요하면 값만 바꿉니다.

# 이미지 태그. 처음 띄운 날의 버전으로 고정해 두면 "언제부터 이상해졌나"를 좁히기 쉽습니다.
GETH_IMAGE=ethereum/client-go:stable
LIGHTHOUSE_IMAGE=sigp/lighthouse:latest

# 데이터 저장 위치(호스트 경로). 디스크 여유가 가장 큰 곳으로 지정하세요.
DATA_DIR=./data

# 장애 연습 2(피어 수 급감)에서 낮춰 보는 값
GETH_MAXPEERS=50
LH_TARGET_PEERS=100

# Sepolia 체크포인트 동기화 주소 (https://eth-clients.github.io/checkpoint-sync-endpoints/)
CHECKPOINT_SYNC_URL=https://checkpoint-sync.sepolia.ethpandaops.io

# Grafana 관리자 비밀번호. 꼭 바꾸세요.
GRAFANA_ADMIN_PASSWORD=change-me
